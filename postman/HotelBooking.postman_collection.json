{
  "info": {
    "name": "Hotel Booking API",
    "description": "Run in order (Collection Runner). The 'Happy path' folder creates the owner/property that later folders reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Stay dates 30 days out so the \"not in the past\" rule always passes",
          "const fmt = d => d.toISOString().slice(0, 10);",
          "const inDays = n => { const d = new Date(); d.setUTCDate(d.getUTCDate() + n); return fmt(d); };",
          "pm.collectionVariables.set('checkIn', inDays(30));",
          "pm.collectionVariables.set('checkOut', inDays(32));",
          "if (!pm.collectionVariables.get('idempotencyKey')) pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "1. Create owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owners"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lakeview Hotels\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b=pm.response.json();",
                  "pm.collectionVariables.set('ownerId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Add property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owners/{{ownerId}}/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owners",
                "{{ownerId}}",
                "properties"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lakeview Palace\",\n  \"city\": \"Udaipur\",\n  \"locality\": \"Pichola\",\n  \"starRating\": 5,\n  \"amenities\": [\n    \"WIFI\",\n    \"POOL\"\n  ],\n  \"roomTypes\": [\n    {\n      \"name\": \"Suite\",\n      \"capacity\": 3,\n      \"basePrice\": 150.0,\n      \"totalRooms\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b=pm.response.json();",
                  "pm.collectionVariables.set('propertyId', b.id);",
                  "pm.collectionVariables.set('roomTypeId', b.roomTypes[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. List owner's properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/owners/{{ownerId}}/properties",
              "host": [
